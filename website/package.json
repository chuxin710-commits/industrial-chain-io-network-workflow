{
  "name": "chainlab-research-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/preview.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/build-method-sources.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "score": "node scripts/compose.mjs",
    "film": "node scripts/render-film.mjs",
    "qa": "node scripts/verify.mjs",
    "qa:production": "node scripts/verify.mjs --production",
    "qa:live": "node scripts/verify.mjs --live",
    "test:preview": "node --test scripts/preview.test.mjs",
    "test:film": "node --test scripts/film-storyboard.test.mjs",
    "test:research": "node --test scripts/research-models.test.mjs",
    "qa:research": "node scripts/verify-research.mjs",
    "qa:research:production": "node scripts/verify-research.mjs --production",
    "api": "node scripts/api-preview.mjs",
    "test:database": "python -m unittest discover -s scripts -p test_database.py -v",
    "qa:workspace": "node scripts/verify-workspace.mjs",
    "qa:topology": "node scripts/verify-topology.mjs",
    "test:topology": "python -m unittest discover -s scripts -p test_topology.py -v",
    "test:reader": "node --test scripts/library-reader.test.mjs",
    "package:feature": "python scripts/package-deploy.py --incremental",
    "package:deploy": "python scripts/package-deploy.py"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.2",
    "cytoscape": "^3.34.4",
    "d3-force": "^3.0.0",
    "gsap": "^3.13.0",
    "katex": "^0.19.0",
    "lenis": "^1.3.11",
    "lucide": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "three": "0.180.0"
  },
  "devDependencies": {
    "playwright": "1.55.1",
    "vite": "^8.0.0"
  }
}
