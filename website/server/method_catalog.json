    },
    {
      "id": "leontief",
      "stage": "network",
      "title": "完全需求网络 L",
      "status": "仓库离线方法",
      "purpose": "刻画直接与间接需求联系，与直接交易网络分开使用。",
      "input": "完整 A，含自身投入",
      "output": "L、谱半径与求解残差",
      "formulas": [
        {
          "label": "Leontief 逆",
          "tex": "L=(I_N-A)^{-1}=I_N+A+A^2+\\cdots,\\qquad \\rho(A)<1",
          "note": "当前实现用线性方程求解 L，保留 A 的对角项；仅在构图时去掉 L 自环。"
        },
        {
          "label": "条件需求响应",
          "tex": "x=Ax+f,\\qquad \\Delta x=L\\Delta f",
          "note": "仅在相同封闭账户、固定系数和相应均衡假设下成立；不是供给约束冲击模型。"
        },
        {
          "label": "数值核验",
          "tex": "r_L=\\max_{i,j}\\left|[(I_N-A)L-I_N]_{ij}\\right|",
          "note": "报告谱半径与残差，而不只给出一张看似平滑的网络图。"
        }
      ],
      "symbols": [
        [
          "I_N",
          "N 阶单位矩阵，不是 SIR 中的受影响比例 I"
        ],
        [
          "L_{ij}",
          "满足 j 最终需求所需的 i 完全产出联系"
        ],
        [
          "\\rho(A)",
          "A 的特征值模的最大值"
        ],
        [
          "f,\\ \\Delta f",
          "与模型账户口径一致的最终需求向量及其变化"
        ]
      ],
      "parameters": [
        [
          "样本",
          "2009–2023，42 行业"
        ],
        [
          "前提",
          "Z 非负、聚合 x 严格为正，ρ(A)<1"
        ],
        [
          "L 网络阈值",
          "0.03121170876198651"
        ],
        [
          "阈值来源",
          "2009 年 L 非对角均值，跨年固定，严格大于"
        ]
      ],
      "steps": [
        "检查 ρ(A)<1 后求解 (I−A)L=I。",
        "核验逆矩阵残差，再对 L 非对角元素取严格阈值。",
        "与 A 网络结果分别报告，不混用阈值与排名。"
      ],
      "boundaries": [
        "L 是模型推导的完全需求联系，不是原表观测的直接交易。",
        "网站尚未开放 L 网络在线生成；此处是仓库方法说明。"
      ],
      "source": [
        "research/structure_resilience/model.py",
        "research/structure_resilience/METHODS.md"
      ]
    },
