    },
    {
      "id": "direct",
      "stage": "network",
      "title": "直接投入网络 A",
      "status": "网站已接入",
      "purpose": "把交易额换成按使用部门总产出标准化的投入系数。",
      "input": "同序 Z 与 x",
      "output": "完整 A；去自环的有向网络 W",
      "formulas": [
        {
          "label": "按列标准化",
          "tex": "A=Z\\,\\operatorname{diag}(x)^{-1},\\qquad a_{ij}=\\frac{z_{ij}}{x_j}",
          "note": "分母是购买者 j 的总产出，不是供给者 i 的总产出。"
        },
        {
          "label": "网站构网规则",
          "tex": "W_{ij}=a_{ij}\\,\\mathbf1(a_{ij}>0)\\,\\mathbf1(a_{ij}\\geq\\tau)\\,\\mathbf1(i\\ne j)",
          "note": "网站使用大于等于阈值，先计算全部阈值关系，再决定图上展示哪些边。"
        }
      ],
      "symbols": [
        [
          "z_{ij}",
          "供给方 i → 使用方 j 的中间交易额"
        ],
        [
          "x_j",
          "使用方 j 的总产出"
        ],
        [
          "a_{ij}",
          "每单位 j 产出对应的 i 中间投入；无量纲"
        ],
        [
          "\\tau,\\ \\mathbf1(\\cdot)",
          "非负阈值与示性函数"
        ]
      ],
      "parameters": [
        [
          "网站默认阈值",
          "0.005，可调；不等于论文案例阈值"
        ],
        [
          "网站支持矩阵",
          "独立网络拓扑模块支持 A 或 Z"
        ],
        [
          "自环",
          "完整 A 保留；绘图与结构网络去除"
        ],
        [
          "零产出",
          "原始零产出行列交易须全零；A 的对应使用列定义为零并保留节点"
        ]
      ],
      "steps": [
        "先检查原始零产出行列，再进行聚合。",
        "用完整矩阵计算 A，按阈值构建有向网络。",
        "完整邻接关系用于查询；稀疏图只承担展示，不替代完整计算。"
      ],
      "boundaries": [
        "A 不是交易概率或冲击概率。交易联系不等于具体企业供货关系。",
        "Z 跨年金额不可在单位和价格口径未知时直接解释为实际增长。"
      ],
      "source": [
        "website/server/topology.py",
