    {
      "id": "contract",
      "stage": "data",
      "title": "数据契约与聚合",
      "status": "网站已接入",
      "purpose": "先统一节点、年份、账户和聚合口径，再讨论产业联系。",
      "input": "省级中间交易 Zᴾ、总产出 xᴾ、地区行业标签",
      "output": "全国行业 Zᴺ、xᴺ；来源与标签核验记录",
      "formulas": [
        {
          "label": "先汇总交易与产出",
          "tex": "Z^{N}=G^{\\mathsf T}Z^{P}G,\\qquad x^{N}=G^{\\mathsf T}x^{P}",
          "note": "每个原始节点只属于一个全国行业；不能对省级 A 直接平均。"
        },
        {
          "label": "聚合守恒",
          "tex": "\\sum_{i,j}Z^{N}_{ij}=\\sum_{u,v}Z^{P}_{uv},\\qquad \\sum_i x^{N}_i=\\sum_u x^{P}_u",
          "note": "相同覆盖范围下核对交易与产出总量，不能据此宣称全部核算账户已经平衡。"
        }
      ],
      "symbols": [
        [
          "G\\in\\{0,1\\}^{1302\\times42}",
          "行业归属矩阵，每行恰好一个 1"
        ],
        [
          "Z^P_{uv}",
          "原始地区行业 u 向 v 提供的中间投入"
        ],
        [
          "x^P_u",
          "原始地区行业 u 的总产出"
        ],
        [
          "t,\\ N",
          "t 为数据年份；N 为当前层级节点数，案例全国行业 N=42"
        ]
      ],
      "parameters": [
        [
          "网站查询范围",
          "2000–2023，31 地区 × 42 行业"
        ],
        [
          "两篇离线案例",
          "2009–2023，全国 42 行业"
        ],
        [
          "标签校验",
          "唯一、行列同序、跨年同序"
        ],
        [
          "金额单位 / 价格基期",
          "待核实；不自动换算"
        ],
        [
          "行业名称",
          "S01–S42 对照未核实，保留代码"
        ]
      ],
      "steps": [
        "核对年份、账户类型、标签及来源哈希。",
        "拒绝构网所需 Z/x 中的非有限值和负值，不用零填补缺失。",
        "依分组矩阵分别汇总 Z 与 x，再进入系数计算。"
      ],
      "boundaries": [
        "目录中的“2D-LQ”是数据标注，不是来源认证；不能称为官方逐年实测表。",
        "2005–2007 年跨年可比性待核实。哈希只区分文件版本，不证明数据真实或具有再分发许可。"
      ],
      "source": [
        "research/DATA_CONTRACT.md",
        "website/server/topology.py"
      ],
      "links": [
