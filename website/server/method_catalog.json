    {
      "id": "topsis",
      "stage": "structure",
      "title": "熵权 TOPSIS",
      "status": "仓库离线方法",
      "purpose": "在同一年度整合四项结构指标，同时明确常数列与并列边界。",
      "input": "N×4 正向指标矩阵 Y",
      "output": "熵权 ω、结构得分 s 与并列诊断",
      "formulas": [
        {
          "label": "标准化与比重",
          "tex": "u_{im}=\\frac{Y_{im}-\\min_iY_{im}}{\\max_iY_{im}-\\min_iY_{im}},\\qquad p_{im}=\\frac{u_{im}}{\\sum_i u_{im}}",
          "note": "极差不超过 10⁻¹² 的列置零并退出有效指标集。"
        },
        {
          "label": "信息量与权重",
          "tex": "e_m=-\\frac{\\sum_i p_{im}\\log p_{im}}{\\log N},\\quad \\omega_m=\\frac{1-e_m}{\\sum_{q\\in\\mathcal V}(1-e_q)},\\quad v_{im}=\\omega_m u_{im}",
          "note": "约定 0 log 0=0；仅非常数列构成有效集合 𝒱。"
        },
        {
          "label": "到理想点的距离",
          "tex": "d_i^{\\pm}=\\sqrt{\\sum_m(v_{im}-v_m^{\\pm})^2},\\qquad s_i=\\frac{d_i^-}{d_i^++d_i^-}",
          "note": "正理想点逐列取最大，负理想点逐列取最小；用加权坐标的欧氏距离。"
        }
      ],
      "symbols": [
        [
          "Y_{im}, u_{im}, p_{im}",
          "节点 i 的第 m 项原始指标、标准化值与列内比重"
        ],
        [
          "e_m,\\omega_m,\\mathcal V",
          "信息熵、熵权与有效指标集合"
        ],
        [
          "v_m^+=\\max_i v_{im},\\ v_m^-=\\min_i v_{im}",
          "正、负理想点"
        ],
        [
          "s_i\\in[0,1]",
          "结构综合得分，越大越靠近正理想点"
        ]
      ],
      "parameters": [
        [
          "有效列阈值",
          "极差 > 10⁻¹²"
        ],
        [
          "全部无信息",
          "所有得分统一为 0.5，权重为零"
        ],
        [
          "排序",
          "稳定索引仅为复现展示，必须同时报告并列"
        ],
        [
          "同分恢复策略",
          "滞后结构得分全同则取消结构优先，回退按损失比例恢复"
        ]
      ],
      "boundaries": [
        "按年标准化与赋权；得分变化并不是固定标尺下的绝对改善。",
        "高聚类被设为正向是案例选择，需用去聚类与等权方案检验，不能视为普遍经济定律。"
      ],
      "source": [
