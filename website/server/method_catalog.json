      "id": "centrality",
      "stage": "structure",
      "title": "四项结构指标",
      "status": "仓库离线方法",
      "purpose": "分别回答连接广度、外向可达性、通道位置和局部闭合程度。",
      "input": "有向二元邻接矩阵 B",
      "output": "四项正向指标；尚非冲击损失或恢复排序",
      "formulas": [
        {
          "label": "度与向外接近",
          "tex": "D_i=\\frac{k_i^{\\mathrm{in}}+k_i^{\\mathrm{out}}}{2(N-1)},\\qquad C_i^{\\mathrm{out}}=\\frac{r_i}{N-1}\\frac{r_i}{\\sum_{j\\in\\mathcal R_i}d_{ij}^{\\mathrm{hop}}}",
          "note": "路径按二元跳数。无可达节点时接近中心性为零；NetworkX 对反向图调用 closeness 得到向外口径。"
        },
        {
          "label": "标准化有向介数",
          "tex": "B_i^{\\mathrm{cen}}=\\frac{1}{(N-1)(N-2)}\\sum_{s\\ne i}\\sum_{\\substack{t\\ne i\\\\t\\ne s}}\\frac{\\sigma_{st}(i)}{\\sigma_{st}}",
          "note": "有向有序配对；不可达配对贡献零，不计端点。N<3 时取零。"
        },
        {
          "label": "二元有向聚类",
          "tex": "C_i^{\\mathrm{clu}}=\\frac{[(B+B^{\\mathsf T})^3]_{ii}}{2\\left[k_i^{\\mathrm{tot}}(k_i^{\\mathrm{tot}}-1)-2k_i^{\\leftrightarrow}\\right]}",
          "note": "采用 Fagiolo 型有向三角形口径；分母为零时取零，B 无自环。"
        }
      ],
      "symbols": [
        [
          "B_{ij}=\\mathbf1(W_{ij}>0)",
          "二元邻接矩阵，与介数 Bᶜᵉⁿ 不同"
        ],
        [
          "k_i^{\\mathrm{in}},k_i^{\\mathrm{out}}",
          "入度、出度；总度 kᵗᵒᵗ 为两者之和"
        ],
        [
          "\\mathcal R_i,r_i,d_{ij}^{\\mathrm{hop}}",
          "从 i 可达的其他节点集合、数量及最短跳数"
        ],
        [
          "\\sigma_{st},\\sigma_{st}(i)",
          "s→t 最短路径总数及经过 i 的数量"
        ],
        [
          "k_i^{\\leftrightarrow}=\\sum_j B_{ij}B_{ji}",
          "与 i 双向相连的邻居数"
        ]
      ],
      "parameters": [
        [
          "权重口径",
          "结构四指标使用二元图，weight=None"
        ],
        [
          "方向",
