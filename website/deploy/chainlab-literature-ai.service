[Unit]
Description=CHAINLAB private PDF summaries and tags
After=network-online.target

[Service]
Type=oneshot
User=chainlab
Group=chainlab
WorkingDirectory=/opt/chainlab/current/server
EnvironmentFile=/etc/chainlab/deepseek.env
ExecStart=/opt/chainlab/current/runtime/bin/python /opt/chainlab/current/server/literature_ai.py --root /var/lib/chainlab/library --workers 3
TimeoutStartSec=3h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chainlab/library
MemoryMax=1G
