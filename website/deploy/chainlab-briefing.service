[Unit]
Description=CHAINLAB public news briefing collection
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=chainlab
Group=chainlab
ExecStart=/opt/chainlab/current/runtime/bin/python /opt/chainlab/current/server/briefing.py
StateDirectory=chainlab/briefing
TimeoutStartSec=600
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/chainlab/briefing

